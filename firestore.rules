rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreAdmin() {
      return request.auth != null
        && request.auth.token.email in ['REPLACE_WITH_ADMIN_EMAIL'];
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isStoreAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'id', 'total', 'status', 'createdAt', 'customer', 'items'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'total', 'status', 'createdAt', 'customer', 'items'
        ])
        && request.resource.data.id == orderId
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasOnly([
          'name', 'email', 'phone', 'address'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30;
      allow read, update, delete: if isStoreAdmin();
    }
  }
}